package trustmark:http@0.1.0;

/// TrustMark HTTP component: accepts POST image/png, returns watermarked image/png.
/// WebGPU imports are declared separately via wasi-webgpu-headers/imports_component_type.o.
world trustmark-http {
  export wasi:http/incoming-handler@0.2.2;
  import wasi:http/types@0.2.2;
  import wasi:io/streams@0.2.2;
  import wasi:io/poll@0.2.2;
  import wasi:clocks/monotonic-clock@0.2.2;
}
